Bootstrap: docker
From: nvidia/cuda:12.4.1-cudnn-devel-ubuntu22.04

# Build:
#   sudo singularity build pokertrainer-cfr.sif scripts/cfr.def
#
# Run on the cluster:
#   singularity exec --nv pokertrainer-cfr.sif \
#     python -m cfr.cfr_mp_gpu --mp-actors 32 --learner-device cuda:0 \
#       --n-iterations 500 --n-traversals-per-iter 10000 \
#       --hidden 512 --n-layers 8 \
#       --ckpt-dir /scratch/$USER/cfr_run_001
#
# The image embeds the engine .so (built inside the container against the
# cu124 PyTorch wheel) so RUNPATH lookup of libtorch works without
# LD_LIBRARY_PATH at run time. See project_libtorch_cmake.md.

%files
    # Copy the entire repo into /opt/pokertrainer. The build below uses it as
    # CWD. This expects scripts/cfr.def to be invoked from the repo root, e.g.:
    #     sudo singularity build pokertrainer-cfr.sif scripts/cfr.def
    # NOTE: %files paths are relative to the CWD of `singularity build`,
    # NOT to the directory containing this .def file — so no `../` here.
    engine        /opt/pokertrainer/engine
    trainer       /opt/pokertrainer/trainer
    scripts       /opt/pokertrainer/scripts
    docs          /opt/pokertrainer/docs

%post
    set -e
    DEBIAN_FRONTEND=noninteractive apt-get update -y
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        python3 python3-dev python3-pip \
        build-essential cmake ninja-build git pkg-config ca-certificates
    rm -rf /var/lib/apt/lists/*

    # PyTorch first — the engine's libpokertrainer.so RUNPATH-links to libtorch.
    pip3 install --no-cache-dir \
        torch --index-url https://download.pytorch.org/whl/cu124
    pip3 install --no-cache-dir numpy

    # Build the engine in-place. PT_BUILD_FFI=ON for the C ABI; PT_BUILD_INFER=ON
    # so libpokertrainer.so includes the LibTorch inference symbols (the
    # cluster will not need pt_infer for CFR training itself, but it's nice
    # to have the same .so usable for downstream eval/inspector binaries).
    cd /opt/pokertrainer/engine
    rm -rf build
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DPT_BUILD_FFI=ON -DPT_BUILD_INFER=ON \
        -DCMAKE_PREFIX_PATH="$(python3 -c 'import torch.utils; print(torch.utils.cmake_prefix_path)')"
    cmake --build build -j"$(nproc)"

    # Sanity: run the pybind smoke + the new clone smoke INSIDE the image so
    # we fail fast at build time if anything went wrong.
    PYTHONPATH=/opt/pokertrainer/engine/build python3 /opt/pokertrainer/engine/tests/smoke_pybind.py
    PYTHONPATH=/opt/pokertrainer/engine/build python3 /opt/pokertrainer/engine/tests/smoke_clone.py
    # CFR probe smoke — catches regressions in cfr/probe.py, CFRAdvPolicy,
    # or the pybind state.hole / invested_this_street API before the cluster
    # launches a multi-hour training job that would crash on first probe.
    PYTHONPATH=/opt/pokertrainer/engine/build:/opt/pokertrainer/trainer \
        python3 /opt/pokertrainer/trainer/tests/smoke_cfr_probe.py

%environment
    export PYTHONPATH=/opt/pokertrainer/engine/build:/opt/pokertrainer/trainer:${PYTHONPATH:-}
    export PYTHONUNBUFFERED=1
    # Sane CPU thread default — the trainer overrides per-actor via
    # --actor-torch-threads, but unset OMP_NUM_THREADS confuses some
    # cluster schedulers. Keep it explicit here.
    export OMP_NUM_THREADS=1

%runscript
    # Default: run whatever module the user passes via "python -m ..." style args.
    # Example: singularity run --nv pokertrainer-cfr.sif cfr.cfr_mp_gpu --mp-actors 16
    cd /opt/pokertrainer/trainer
    exec python3 -m "$@"

%labels
    Author elucterio@gmail.com
    Project PokerTrainer-CFR
    PyTorch cu124
